generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Branch {
  id               String            @id @default(cuid())
  name             String
  code             String            @unique
  address          String?
  phone            String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  auditLogs        AuditLog[]
  cashMovements    CashMovement[]
  cashShifts       CashShift[]
  cashierShifts    CashierShift[]
  customerPayments CustomerPayment[]
  expenses         Expense[]
  products         ProductBranch[]
  purchases        Purchase[]
  purchasePayments PurchasePayment[]
  purchaseReturns  PurchaseReturn[]
  sales            Sale[]
  saleReturns      SaleReturn[]
  stockMovements   StockMovement[]
  transfersFrom    StockTransfer[]   @relation("TransferFrom")
  transfersTo      StockTransfer[]   @relation("TransferTo")
  users            User[]

  @@index([isActive])
  @@index([createdAt])
}

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  passwordHash     String
  role             UserRole          @default(CASHIER)
  isActive         Boolean           @default(true)
  branchId         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  auditLogs        AuditLog[]
  cashMovements    CashMovement[]
  cashShifts       CashShift[]
  cashierShifts    CashierShift[]
  customerPayments CustomerPayment[]
  expenses         Expense[]
  purchases        Purchase[]
  purchasePayments PurchasePayment[]
  purchaseReturns  PurchaseReturn[]
  sales            Sale[]
  saleReturns      SaleReturn[]
  branch           Branch?           @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([role])
  @@index([isActive])
  @@index([createdAt])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  code      String?   @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([isActive])
  @@index([createdAt])
}

model Supplier {
  id               String            @id @default(cuid())
  name             String
  phone            String?
  email            String?
  address          String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  purchases        Purchase[]
  purchasePayments PurchasePayment[]
  purchaseReturns  PurchaseReturn[]

  @@index([isActive])
  @@index([createdAt])
}

model Product {
  id                  String               @id @default(cuid())
  
  barcode             String?              @unique
  name                String
  costPrice           Decimal              @db.Decimal(12, 2)
  sellingPrice        Decimal              @db.Decimal(12, 2)
  unit                String               @default("pcs")
  status              ProductStatus        @default(ACTIVE)
  categoryId          String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  category            Category?            @relation(fields: [categoryId], references: [id])
  branches            ProductBranch[]
  purchaseItems       PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]
  saleItems           SaleItem[]
  saleReturnItems     SaleReturnItem[]
  stockMovements      StockMovement[]
  transferItems       StockTransferItem[]

  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
}

model ProductBranch {
  id        String   @id @default(cuid())
  productId String
  branchId  String
  stock     Decimal  @default(0) @db.Decimal(12, 2)
  minStock  Decimal  @default(0) @db.Decimal(12, 2)
  maxStock  Decimal? @db.Decimal(12, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@index([branchId])
  @@index([productId])
  @@index([isActive])
}

model Purchase {
  id            String            @id @default(cuid())
  invoiceNumber String            @unique
  supplierId    String?
  branchId      String
  userId        String
  subtotal      Decimal           @db.Decimal(12, 2)
  discount      Decimal           @default(0) @db.Decimal(12, 2)
  tax           Decimal           @default(0) @db.Decimal(12, 2)
  total         Decimal           @db.Decimal(12, 2)
  status        PurchaseStatus    @default(RECEIVED)
  purchasedAt   DateTime          @default(now())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  branch        Branch            @relation(fields: [branchId], references: [id])
  supplier      Supplier?         @relation(fields: [supplierId], references: [id])
  user          User              @relation(fields: [userId], references: [id])
  items         PurchaseItem[]
  payments      PurchasePayment[]
  returns       PurchaseReturn[]
}

model PurchaseItem {
  id                  String               @id @default(cuid())
  purchaseId          String
  productId           String
  quantity            Decimal              @db.Decimal(12, 2)
  costPrice           Decimal              @db.Decimal(12, 2)
  total               Decimal              @db.Decimal(12, 2)
  product             Product              @relation(fields: [productId], references: [id])
  purchase            Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  purchaseReturnItems PurchaseReturnItem[]

  @@index([purchaseId])
  @@index([productId])
}

model Sale {
  id            String        @id @default(cuid())
  receiptNumber String        @unique
  branchId      String
  cashierId     String
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  paidAmount    Decimal       @db.Decimal(12, 2)
  changeAmount  Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  status        SaleStatus    @default(COMPLETED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  customerId    String?
  branch        Branch        @relation(fields: [branchId], references: [id])
  cashier       User          @relation(fields: [cashierId], references: [id])
  customer      Customer?     @relation(fields: [customerId], references: [id])
  items         SaleItem[]
  returns       SaleReturn[]

  @@index([branchId])
  @@index([cashierId])
  @@index([customerId])
  @@index([createdAt])
}

model SaleItem {
  id          String           @id @default(cuid())
  saleId      String
  productId   String
  productName String
  quantity    Decimal          @db.Decimal(12, 2)
  unitPrice   Decimal          @db.Decimal(12, 2)
  costPrice   Decimal          @db.Decimal(12, 2)
  discount    Decimal          @default(0) @db.Decimal(12, 2)
  total       Decimal          @db.Decimal(12, 2)
  returnedQty Decimal          @default(0) @db.Decimal(12, 2)
  product     Product          @relation(fields: [productId], references: [id])
  sale        Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  returns     SaleReturnItem[]

  @@index([saleId])
  @@index([productId])
}

model StockMovement {
  id          String            @id @default(cuid())
  productId   String
  branchId    String
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 2)
  referenceId String?
  note        String?
  createdAt   DateTime          @default(now())
  branch      Branch            @relation(fields: [branchId], references: [id])
  product     Product           @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([branchId])
  @@index([type])
  @@index([referenceId])
  @@index([createdAt])
}

model StockTransfer {
  id           String              @id @default(cuid())
  fromBranchId String
  toBranchId   String
  status       TransferStatus      @default(PENDING)
  note         String?
  createdAt    DateTime            @default(now())
  completedAt  DateTime?
  fromBranch   Branch              @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch     Branch              @relation("TransferTo", fields: [toBranchId], references: [id])
  items        StockTransferItem[]

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
  @@index([createdAt])
}

model StockTransferItem {
  id         String        @id @default(cuid())
  transferId String
  productId  String
  quantity   Decimal       @db.Decimal(12, 2)
  product    Product       @relation(fields: [productId], references: [id])
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([productId])
}

model Expense {
  id        String        @id @default(cuid())
  branchId  String
  userId    String
  title     String
  amount    Decimal       @db.Decimal(12, 2)
  note      String?
  status    ExpenseStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  branch    Branch        @relation(fields: [branchId], references: [id])
  user      User          @relation(fields: [userId], references: [id])

  @@index([branchId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model CashierShift {
  id           String      @id @default(cuid())
  branchId     String
  cashierId    String
  openingCash  Decimal     @db.Decimal(12, 2)
  closingCash  Decimal?    @db.Decimal(12, 2)
  expectedCash Decimal?    @db.Decimal(12, 2)
  difference   Decimal?    @db.Decimal(12, 2)
  totalSales   Decimal     @default(0) @db.Decimal(12, 2)
  cashSales    Decimal     @default(0) @db.Decimal(12, 2)
  cardSales    Decimal     @default(0) @db.Decimal(12, 2)
  kbzpaySales  Decimal     @default(0) @db.Decimal(12, 2)
  waveSales    Decimal     @default(0) @db.Decimal(12, 2)
  otherSales   Decimal     @default(0) @db.Decimal(12, 2)
  status       ShiftStatus @default(OPEN)
  openedAt     DateTime    @default(now())
  closedAt     DateTime?
  branch       Branch      @relation(fields: [branchId], references: [id])
  cashier      User        @relation(fields: [cashierId], references: [id])

  @@index([branchId])
  @@index([cashierId])
  @@index([status])
  @@index([openedAt])
}

model SaleReturn {
  id           String           @id @default(cuid())
  returnNumber String           @unique
  saleId       String
  branchId     String
  userId       String
  refundAmount Decimal          @db.Decimal(12, 2)
  reason       String?
  status       SaleReturnStatus @default(COMPLETED)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  branch       Branch           @relation(fields: [branchId], references: [id])
  sale         Sale             @relation(fields: [saleId], references: [id])
  user         User             @relation(fields: [userId], references: [id])
  items        SaleReturnItem[]

  @@index([saleId])
  @@index([branchId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model SaleReturnItem {
  id           String     @id @default(cuid())
  saleReturnId String
  saleItemId   String
  productId    String
  quantity     Decimal    @db.Decimal(12, 2)
  unitPrice    Decimal    @db.Decimal(12, 2)
  total        Decimal    @db.Decimal(12, 2)
  product      Product    @relation(fields: [productId], references: [id])
  saleItem     SaleItem   @relation(fields: [saleItemId], references: [id])
  saleReturn   SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)

  @@index([saleReturnId])
  @@index([saleItemId])
  @@index([productId])
}

model PurchaseReturn {
  id           String               @id @default(cuid())
  returnNumber String               @unique
  purchaseId   String
  supplierId   String?
  branchId     String
  userId       String
  total        Decimal              @db.Decimal(12, 2)
  reason       String?
  status       PurchaseReturnStatus @default(COMPLETED)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  branch       Branch               @relation(fields: [branchId], references: [id])
  purchase     Purchase             @relation(fields: [purchaseId], references: [id])
  supplier     Supplier?            @relation(fields: [supplierId], references: [id])
  user         User                 @relation(fields: [userId], references: [id])
  items        PurchaseReturnItem[]

  @@index([purchaseId])
  @@index([supplierId])
  @@index([branchId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model PurchaseReturnItem {
  id               String         @id @default(cuid())
  purchaseReturnId String
  purchaseItemId   String
  productId        String
  quantity         Decimal        @db.Decimal(12, 2)
  costPrice        Decimal        @db.Decimal(12, 2)
  total            Decimal        @db.Decimal(12, 2)
  product          Product        @relation(fields: [productId], references: [id])
  purchaseItem     PurchaseItem   @relation(fields: [purchaseItemId], references: [id])
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)

  @@index([purchaseReturnId])
  @@index([purchaseItemId])
  @@index([productId])
}

model PurchasePayment {
  id            String                @id @default(cuid())
  purchaseId    String
  supplierId    String?
  branchId      String
  userId        String
  amount        Decimal               @db.Decimal(12, 2)
  paymentMethod PurchasePaymentMethod
  reference     String?
  note          String?
  createdAt     DateTime              @default(now())
  branch        Branch                @relation(fields: [branchId], references: [id])
  purchase      Purchase              @relation(fields: [purchaseId], references: [id])
  supplier      Supplier?             @relation(fields: [supplierId], references: [id])
  user          User                  @relation(fields: [userId], references: [id])

  @@index([purchaseId])
  @@index([supplierId])
  @@index([branchId])
  @@index([createdAt])
}

model Customer {
  id          String            @id @default(cuid())
  name        String
  phone       String?           @unique
  email       String?
  address     String?
  creditLimit Decimal           @default(0) @db.Decimal(12, 2)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  payments    CustomerPayment[]
  sales       Sale[]

  @@index([name])
  @@index([phone])
}

model CustomerPayment {
  id            String                @id @default(cuid())
  customerId    String
  branchId      String
  userId        String
  amount        Decimal               @db.Decimal(12, 2)
  paymentMethod CustomerPaymentMethod
  reference     String?
  note          String?
  createdAt     DateTime              @default(now())
  branch        Branch                @relation(fields: [branchId], references: [id])
  customer      Customer              @relation(fields: [customerId], references: [id])
  user          User                  @relation(fields: [userId], references: [id])

  @@index([customerId])
  @@index([branchId])
  @@index([createdAt])
}

model CashShift {
  id           String         @id @default(cuid())
  branchId     String
  cashierId    String
  openingCash  Decimal        @db.Decimal(12, 2)
  closingCash  Decimal?       @db.Decimal(12, 2)
  expectedCash Decimal?       @db.Decimal(12, 2)
  difference   Decimal?       @db.Decimal(12, 2)
  status       ShiftStatus    @default(OPEN)
  openedAt     DateTime       @default(now())
  closedAt     DateTime?
  note         String?
  movements    CashMovement[]
  branch       Branch         @relation(fields: [branchId], references: [id])
  cashier      User           @relation(fields: [cashierId], references: [id])

  @@index([branchId])
  @@index([cashierId])
  @@index([status])
  @@index([openedAt])
}

model CashMovement {
  id        String           @id @default(cuid())
  shiftId   String
  branchId  String
  userId    String
  type      CashMovementType
  amount    Decimal          @db.Decimal(12, 2)
  reason    String?
  reference String?
  createdAt DateTime         @default(now())
  branch    Branch           @relation(fields: [branchId], references: [id])
  shift     CashShift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id])

  @@index([shiftId])
  @@index([branchId])
  @@index([createdAt])
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  branchId    String?
  action      AuditAction
  module      String
  entityId    String?
  description String?
  oldData     Json?
  newData     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())
  branch      Branch?     @relation(fields: [branchId], references: [id])
  user        User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([branchId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
}

model SystemSetting {
  id          String      @id @default(cuid())
  key         String      @unique
  value       String?
  type        SettingType @default(TEXT)
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([isActive])
  @@index([createdAt])
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  CASHIER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum PaymentMethod {
  CASH
  CARD
  KBZPAY
  WAVE
  OTHER
}

enum PurchasePaymentMethod {
  CASH
  KBZPAY
  WAVE
  BANK
  CARD
  OTHER
}

enum SaleStatus {
  COMPLETED
  VOIDED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum StockMovementType {
  PURCHASE
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

enum PurchaseStatus {
  RECEIVED
  PARTIAL
  CANCELLED
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ExpenseStatus {
  ACTIVE
  VOIDED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum SaleReturnStatus {
  COMPLETED
  CANCELLED
}

enum PurchaseReturnStatus {
  COMPLETED
  CANCELLED
}

enum CustomerPaymentMethod {
  CASH
  KBZPAY
  WAVE
  BANK
  CARD
  OTHER
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VOID
  REFUND
  LOGIN
  LOGOUT
  STOCK_IN
  STOCK_OUT
  TRANSFER
  PAYMENT
}

enum SettingType {
  TEXT
  NUMBER
  BOOLEAN
  JSON
}
